{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fonoster",
  "description": "The AI that answers the phone. Build, test, and run voice agents on real phone lines.",
  "colors": {
    "primary": "#008751",
    "light": "#39E19E",
    "dark": "#008751"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#181818"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://fonoster.com"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Poppins"
    }
  },
  "banner": {
    "content": "**The biggest update in Fonoster history.** The old version shuts down by early January. [Read the upgrade plan](/upgrade)",
    "dismissible": true
  },
  "styling": {
    "codeblocks": "system"
  },
