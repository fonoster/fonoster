# Docker Compose settings for this install. `npx -p @fonoster/common fonoster-config init` copies
# this file to .env, detects HOST_IP and generates every empty secret below. Running init again
# keeps what .env already has and only adds names a newer bundle introduces.
#
# Fonoster services don't read this file: Compose passes its values to their containers
# (env_file), where config/*.yaml reference them as ${NAME}. Change a value here, then recreate
# the containers (docker compose up -d --force-recreate).

# The Fonoster images (fonoster/<service>:<version>).
FONOSTER_VERSION=0.30.0
COMPOSE_PROJECT_NAME=fonoster

# The address softphones, carriers and browsers reach this machine at. Detected by init
# (`--host-ip <address>` sets it).
HOST_IP=
# Dashboard and API (gRPC, gRPC-Web and /api) on one port, plain HTTP. HTTP_BIND=127.0.0.1
# publishes it on this machine only (for a reverse proxy in front that terminates TLS).
HTTP_PORT=8449
# HTTP_BIND=0.0.0.0
# The dashboard and API as browsers reach them. Plain HTTP is for a trusted network: on the
# internet, use HTTPS (below, or a reverse proxy) and set PUBLIC_URL=https://<your domain>.
PUBLIC_URL=http://${HOST_IP}:${HTTP_PORT}
# HTTPS (compose.tls.yaml): Envoy serves 443 with your certificate and redirects 80. Uncomment the
# three lines, set PUBLIC_URL to https://<the certificate's domain>, run init again, then
# docker compose up -d. The files are PEM (Let's Encrypt's fullchain.pem and privkey.pem).
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
# TLS_CERT=/etc/letsencrypt/live/voice.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/voice.example.com/privkey.pem
# Other browser origins that may call the API (CORS), comma-separated; the dashboard is served on
# PUBLIC_URL and needs none. Unset: none.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SIP (UDP and TCP).
SIP_PORT=5060
# RTP for carriers and softphones (RTPEngine) and the media node's range.
RTPENGINE_PORT_MIN=10000
RTPENGINE_PORT_MAX=10999
ROOMR_RTP_PORT_MIN=11000
ROOMR_RTP_PORT_MAX=11999
# Host-only ports: MinIO (call records) and NATS.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_PORT=4222
# Your OpenTelemetry collector's OTLP/HTTP endpoint (e.g. http://collector.example.com:4318);
# empty sends no telemetry. Every Fonoster service reads it as telemetry.otlpEndpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers a hosted collector needs (Grafana Cloud, Honeycomb, ...), as key=value,key=value
# (e.g. Authorization=Basic%20...). Treat it as a secret: keep this file private.
OTEL_EXPORTER_OTLP_HEADERS=
# Optional; the services export OTLP over HTTP (http/json), so leave empty or http/protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=
# The containers' private network (<prefix>.0/24). Change it if it collides with one of yours.
SUBNET_PREFIX=10.216.30

# The dashboard owner. The password is generated by init (`fonoster-config info` prints it).
OWNER_EMAIL=admin@fonoster.local
OWNER_PASSWORD=

# Generated secrets. Keep a backup of this file: the encryption key protects stored vendor keys.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=fonoster
MINIO_ROOT_PASSWORD=
NATS_APISERVER_PASSWORD=
NATS_GATEWAY_PASSWORD=
NATS_ROOMR_PASSWORD=
NATS_ROUTR_PASSWORD=
ENCRYPTION_KEY=
AUTOPILOT_SIGNING_SECRET=
ROOMR_PASSWORD=
