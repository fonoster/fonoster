# Copy to ops/rebuild/cell/.env and fill in. These never leave the cell.
POSTGRES_PASSWORD=
# Encrypts secret columns of the cell database (app signing secrets, webhook secrets).
CELL_ENCRYPTION_KEY=
# Unlocks the cell's secret store (provider keys set with `fonoster-regions secrets set`).
FONOSTER_REGION_SECRETS_KEY=
AUTOPILOT_SIGNING_SECRET=
RB_NODE_PASSWORD=
MINIO_ROOT_PASSWORD=
# One NATS user per service (add-platform 4.1). A letter then hex (n$(openssl rand -hex 16)): Routr's
# goes into a URL, and NATS can't load a value that starts with a digit.
NATS_GATEWAY_PASSWORD=
NATS_MEDIANODE_PASSWORD=
NATS_ROUTR_PASSWORD=
NATS_REGION_AGENT_PASSWORD=
# The address carriers and phones reach for SIP and RTP.
ROUTR_EXTERNAL_ADDRS=127.0.0.1
