# Copy to ops/rebuild/cell/.env and fill in. These never leave the cell.
POSTGRES_PASSWORD=
# Encrypts secret columns of the cell database (app signing secrets, webhook secrets).
CELL_ENCRYPTION_KEY=
# Unlocks the cell's secret store (provider keys set with `fonoster-region secrets set`).
FONOSTER_REGION_SECRETS_KEY=
AUTOPILOT_SIGNING_SECRET=
RB_NODE_PASSWORD=
MINIO_ROOT_PASSWORD=
# The address carriers and phones reach for SIP and RTP.
ROUTR_EXTERNAL_ADDRS=127.0.0.1
