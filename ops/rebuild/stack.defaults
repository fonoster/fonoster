# Defaults for the local rebuild stack (`ops/rebuild/stack`). Copied once into
# ops/rebuild/.local/.env with the bundle's names derived from them, which you may edit; secrets
# are generated there (ops/bundle/init.sh), never here.
#
# Host ports live in 16000-16999 so the stack runs next to a legacy Fonoster stack (5060-5063,
# 8449, 50051, 4222, 5432, 8080, ...).
COMPOSE_PROJECT_NAME=rb-stack
RB_CONFIG_DIR=./.local/config
# Local image names (rb-stack/<service>:dev), built from this checkout.
RB_REGISTRY=rb-stack
RB_TAG=dev

# Envoy: the dashboard and the API (gRPC, gRPC-Web, /api and /sip) on one port, over HTTPS with the
# certificate the stack generates in .local/config/tls/ (the bundle's default; clients trust
# .local/config/tls/ca.pem, browsers warn once).
RB_API_PORT=16449
# Routr SIP (UDP and TCP). Routr also listens on this port inside its container, so the port
# in Via and Record-Route is the one softphones reach.
RB_SIP_PORT=16060
RB_NATS_PORT=16222
RB_APPBRIDGE_PORT=16808
RB_MINIO_PORT=16900
RB_MINIO_CONSOLE_PORT=16901
RB_CALLER_PORT=16080
# Envoy's plain-HTTP port, which only redirects to https://localhost:RB_API_PORT.
RB_HTTPS_REDIRECT_PORT=16081
RB_FAKES_OAUTH2_PORT=16704
# RTPEngine (carrier and softphone media) and the Roomr node's RTP range.
RTPENGINE_PORT_MIN=16100
RTPENGINE_PORT_MAX=16199
RB_NODE_RTP_MIN=16200
RB_NODE_RTP_MAX=16299

# The stack's private network. Routr, RTPEngine, the Roomr node, AppBridge and the caller bot get
# fixed addresses in it (RB_NET.40-.44); change it if it collides with one of your networks.
RB_NET=10.216.16
