#!/usr/bin/env bash
# Builds a self-host release locally (add-self-host-installer 4.2):
#
#   ops/release/bundle [version]
#
# Writes dist/release/<version>/:
#   fonoster-<version>.tar.gz          init.sh, compose files, config/, README.md and ansible/ (the
#                                      playbook, for operated hosts and private regions)
#   SHA256SUMS                         its SHA-256 (`sha256sum -c SHA256SUMS`)
# and tags the Fonoster images fonoster/<service>:<version> in the local Docker.
#
# The version defaults to lerna.json's plus "-local". SKIP_IMAGES=1 skips the image builds.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VERSION="${1:-$(node -p "require('$ROOT/lerna.json').version")-local}"
OUT="$ROOT/dist/release/$VERSION"
STAGE="$OUT/stage/fonoster"

log() { printf '\033[1m[bundle]\033[0m %s\n' "$*" >&2; }

build_images() {
  # The image list lives in ops/release/images.json (shared with .github/workflows/images.yaml);
  # the archive's compose.yaml runs the entries marked "bundle".
  local svc ctx file
  while IFS=$'\t' read -r svc ctx file; do
    log "image fonoster/$svc:$VERSION"
    docker build -q -t "fonoster/$svc:$VERSION" -f "$ROOT/$file" "$ROOT/$ctx" >/dev/null
  done < <(node -e '
    const { images } = require(process.argv[1]);
    for (const i of images.filter((i) => i.bundle)) console.log([i.name, i.context, i.dockerfile].join("\t"));
  ' "$ROOT/ops/release/images.json")
}

build_archive() {
  log "archive fonoster-$VERSION.tar.gz"
  rm -rf "$OUT/stage"
  mkdir -p "$STAGE"
  cp -R "$ROOT/ops/bundle/." "$STAGE/"
  # Generated by init.sh in the install folder, never shipped; its tests stay here.
  rm -rf "$STAGE/.env" "$STAGE/config/keys" "$STAGE/config/tls" "$STAGE/test"
  sed "s/^FONOSTER_VERSION=.*/FONOSTER_VERSION=$VERSION/" "$ROOT/ops/bundle/init.sh" >"$STAGE/init.sh"
  chmod 755 "$STAGE/init.sh"
  # The playbook without anyone's inventory or the throwaway test.
  mkdir -p "$STAGE/ansible"
  cp -R "$ROOT/ops/ansible/." "$STAGE/ansible/"
  rm -rf "$STAGE/ansible/inventory" "$STAGE/ansible/test" "$STAGE/ansible/.ansible"
  # Nothing a self-hoster reads names the rebuild (self-host-installer spec).
  if grep -rniE 'rebuild|RB_' "$STAGE" >&2; then
    log "the archive mentions the rebuild (above); fix ops/bundle"
    exit 1
  fi
  COPYFILE_DISABLE=1 tar -czf "$OUT/fonoster-$VERSION.tar.gz" -C "$OUT/stage" fonoster
  rm -rf "$OUT/stage"
}

checksums() {
  log "SHA256SUMS"
  (cd "$OUT" && shasum -a 256 "fonoster-$VERSION.tar.gz" >SHA256SUMS)
}

mkdir -p "$OUT"
[ "${SKIP_IMAGES:-}" = "1" ] || build_images
build_archive
checksums

log "done: $OUT"
cat >&2 <<EOF

Install from these files in an empty folder:

  tar -xzf $OUT/fonoster-$VERSION.tar.gz && cd fonoster
  ./init.sh
  docker compose up -d
EOF
