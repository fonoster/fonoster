#!/usr/bin/env bash
# Builds a self-host release locally (add-self-host-installer 4.2):
#
#   ops/release/bundle [version]
#
# Writes dist/release/<version>/:
#   fonoster-<version>.tar.gz          compose.yaml, .env.example, config/ (with schemas/), README.md
#   fonoster-common-<version>.tgz      @fonoster/common, for `npx -p <tgz> fonoster-config ...`
# and tags the Fonoster images fonoster/<service>:<version> in the local Docker.
#
# The version defaults to lerna.json's plus "-local". SKIP_IMAGES=1 skips the image builds.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VERSION="${1:-$(node -p "require('$ROOT/lerna.json').version")-local}"
OUT="$ROOT/dist/release/$VERSION"
STAGE="$OUT/stage/fonoster"

log() { printf '\033[1m[bundle]\033[0m %s\n' "$*" >&2; }

build_images() {
  # service:context:dockerfile (dockerfile relative to the context; "-" = context's Dockerfile)
  local specs=(
    "medianode:go/medianode:-"
    "gateway:.:mods/gateway/Dockerfile"
    "autopilot:.:mods/autopilot/Dockerfile"
    "apiserver:.:ops/rebuild/docker/apiserver.Dockerfile"
    "dashboard:.:ops/rebuild/docker/dashboard.Dockerfile"
  )
  local spec svc ctx file
  for spec in "${specs[@]}"; do
    IFS=: read -r svc ctx file <<<"$spec"
    log "image fonoster/$svc:$VERSION"
    if [ "$file" = "-" ]; then
      docker build -q -t "fonoster/$svc:$VERSION" "$ROOT/$ctx" >/dev/null
    else
      docker build -q -t "fonoster/$svc:$VERSION" -f "$ROOT/$file" "$ROOT/$ctx" >/dev/null
    fi
  done
}

build_archive() {
  log "archive fonoster-$VERSION.tar.gz"
  rm -rf "$OUT/stage"
  mkdir -p "$STAGE"
  cp -R "$ROOT/ops/bundle/." "$STAGE/"
  # Generated by init in the install folder, never shipped.
  rm -rf "$STAGE/.env" "$STAGE/config/keys"
  sed -i.bak "s/^FONOSTER_VERSION=.*/FONOSTER_VERSION=$VERSION/" "$STAGE/.env.example"
  rm -f "$STAGE/.env.example.bak"
  (cd "$ROOT" && npx tsx mods/common/scripts/export-config-schemas.ts "$STAGE/config/schemas" >/dev/null)
  # Nothing a self-hoster reads names the rebuild (self-host-installer spec).
  if grep -rniE 'rebuild|RB_' "$STAGE" >&2; then
    log "the archive mentions the rebuild (above); fix ops/bundle"
    exit 1
  fi
  COPYFILE_DISABLE=1 tar -czf "$OUT/fonoster-$VERSION.tar.gz" -C "$OUT/stage" fonoster
  rm -rf "$OUT/stage"
}

pack_common() {
  log "package fonoster-common-$VERSION.tgz"
  (cd "$ROOT/mods/common" && npx tsc -b && cp -a src/protos dist)
  local tgz
  tgz="$(cd "$ROOT/mods/common" && npm pack --silent --pack-destination "$OUT")"
  mv "$OUT/$tgz" "$OUT/fonoster-common-$VERSION.tgz"
}

mkdir -p "$OUT"
[ "${SKIP_IMAGES:-}" = "1" ] || build_images
build_archive
pack_common

log "done: $OUT"
cat >&2 <<EOF

Install from these files in an empty folder:

  tar -xzf $OUT/fonoster-$VERSION.tar.gz && cd fonoster
  npx -y -p $OUT/fonoster-common-$VERSION.tgz fonoster-config init
  docker compose up -d
  npx -y -p $OUT/fonoster-common-$VERSION.tgz fonoster-config info
EOF
