                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Status colors and surface/accent-subtle dark values are proposals — not yet in the Figma library.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
