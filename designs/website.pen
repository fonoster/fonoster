                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M2xLd",
                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Text on mint is always Fonoster/07 #011900 — never white.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "mDuZZ",
                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Dark is the default marketing mode (category norm: Vapi, LiveKit, Pipecat). Light mode for docs/long reads.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
