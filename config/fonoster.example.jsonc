// fonoster.jsonc — the same configuration as fonoster.example.yaml, written as
// JSON with comments. Use one or the other: two files for the API server stop
// it at boot. Trimmed to the required keys; every key from the YAML works here.
{
  "$schema": "https://fonoster.com/schemas/fonoster.json",
  "domain": "fonoster.local",
  "database": {
    "url": "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/fonoster",
  },
  "encryption": { "key": "k1.aesgcm256.MmPSvzCG9fk654bAbl30tsqq4h9d3N4F11hlue8bGAY=" },
  "nats": { "url": "nats://nats:4222" },
  "influxdb": {
    "url": "http://influxdb:8086",
    "org": "${INFLUXDB_INIT_ORG}",
    "username": "${INFLUXDB_INIT_USERNAME}",
    "password": "${INFLUXDB_INIT_PASSWORD}",
    "token": "${INFLUXDB_INIT_TOKEN}",
  },
  "identity": {
    "database": {
      "url": "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/fnidentity",
    },
    "owner": { "name": "Admin", "email": "admin@fonoster.local", "password": "changeme" },
  },
}
