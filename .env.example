# General Notes
# -------------
#
# You must set the following variables to the IP address of the host machine:
#
# - ROUTR_EXTERNAL_ADDRS
# - ROUTR_RTPENGINE_HOST
#
# Note: If you are running in a cloud environment, this will be the public IP address of your server.
# If you are running locally, this will be the IP address of your local machine.
#
# Please ensure you change the default secrets for all services in production
# environments (MEDIANODE_PASSWORD, INFLUXDB_INIT_PASSWORD,
# POSTGRES_PASSWORD).

# Dashboard Settings
# -----------------
# The API's public URL as the browser reaches it (Envoy), for example
# https://api.example.com or http://<host>:8449. Without it the dashboard only
# shows a configuration error. Sign-in methods, sign-up and billing come from
# features.* in config/fonoster.yaml.
DASHBOARD_API_URL=http://localhost:8449

# Fonoster's own services
# -----------------------
# The API server and Autopilot are configured by config/fonoster.yaml and
# config/autopilot.yaml (copy the *.example.* files), not by this file. A few
# values below are shared with them: fonoster.yaml references POSTGRES_*,
# INFLUXDB_INIT_* and MEDIANODE_PASSWORD as ${VAR}, so each
# value is written once, here.

# Routr Settings
# -------------
# The external address must be configured to an address accessible by all endpoints.
# For local network deployments, this is typically your router's public IP address.
# For cloud deployments, this is typically the public IP address of your cloud instance.
ROUTR_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/routr
ROUTR_EXTERNAL_ADDRS=/* Set to the IP address of the host */
ROUTR_LOGS_FORMAT=none
ROUTR_LOGS_LEVEL=verbose
ROUTR_LOGS_TRANSPORT=none
ROUTR_NATS_PUBLISHER_ENABLED=true
ROUTR_NATS_PUBLISHER_URL=nats://nats:4222
ROUTR_RTPENGINE_HOST=rtpengine

# Media node Settings
# -------------------
# The Go media nodes register with Routr as the media-node peer with this password
# (fonoster.yaml routr.mediaNodePeer.password references it).
# Generate one: openssl rand -hex 16
MEDIANODE_PASSWORD=

# RTP Engine Settings
# ------------------
# Set RTPENGINE_PUBLIC_IP to the same value as ROUTR_EXTERNAL_ADDRS
# Adjust RTPENGINE_PORT_MIN and RTPENGINE_PORT_MAX to define the range for media traffic.
RTPENGINE_PORT_MAX=20000
RTPENGINE_PORT_MIN=10000
RTPENGINE_PUBLIC_IP=/* Set to the IP address of the host */

# InfluxDB Settings
# ----------------
INFLUXDB_INIT_ORG=fonoster
INFLUXDB_INIT_PASSWORD=
INFLUXDB_INIT_TOKEN=
INFLUXDB_INIT_USERNAME=influxdb

# Database Security Configuration
# -----------------------------
# For production environments, we recommend using a managed database service
# Generate one: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_USER=postgres

NODE_ENV=production
