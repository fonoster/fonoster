{
  "name": "root",
  "version": "independent",
  "private": true,
  "description": "The AI that answers the phone.",
  "bugs": {
    "url": "https://github.com/fonoster/fonoster/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonoster/fonoster.git"
  },
  "license": "MIT",
  "author": "Pedro Sanders <psanders@fonoster.com>",
  "type": "module",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "test": "test",
    "src": "src"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "mods/*",
    "tools/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "check:docs": "cd docs-site && npx --yes mint@4.2.1045 broken-links",
    "clean": "rimraf \"mods/*/dist\" \"mods/*/node_modules\" \"mods/*/tsconfig.tsbuildinfo\" \"mods/*/package-lock.json\" node_modules package-lock.json",
    "dev": "fonoster-dev",
    "dev:config": "sh .devcontainer/initialize.sh --refresh",
    "dev:e2e-setup": "npx playwright install --with-deps chromium",
    "dev:info": "node mods/common/dist/config/cli/index.js info --dir .dev",
    "format": "prettier --write mods/*/src",
    "generate:protos": "npm run generate:protos -w @fonoster/sdk && npm run build",
    "generate:readme": "lerna run generate:readme && git add mods/**/README.md",
    "integration": "npm run test:integration --workspaces --if-present",
    "integration:evals": "npm run test:evals -w @fonoster/autopilot",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run generate:prisma --workspaces --if-present",
    "prepare": "husky",
    "release": "lerna publish --yes --no-git-reset --dist-tag latest $(./ops/release/next-release.sh) --message \"chore(release): publish %s [skip ci]\"",
    "start:docs": "cd docs-site && npx --yes mint@4.2.1045 dev --port 3333",
    "sync:roomr": "node mods/common/scripts/sync-roomr-protos.cjs",
    "test": "cross-env LOGS_LEVEL=none NODE_ENV=development mocha --timeout 30000 --ignore 'mods/**/*.integration.test.ts' 'mods/!(dashboard)/**/*.test.ts' 'ops/**/*.test.ts'"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "xstate": "5.17.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/eslintrc": "^3.3.3",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.19.0",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-headers": "^1.3.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-loops": "^0.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.13.0",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "husky": "^9.0.11",
    "lerna": "^10.1.1",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.11",
    "nx": "^23.3.0",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "protoc-gen-grpc-web": "^1.5.0",
    "protoc-gen-js": "^3.21.4-4",
    "rimraf": "^6.1.2",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.21.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.29.1",
    "@rollup/rollup-linux-arm64-musl": "^4.29.1",
    "@rollup/rollup-linux-x64-gnu": "^4.29.1",
    "@rollup/rollup-linux-x64-musl": "^4.29.1"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "overrides": {
    "@grpc/grpc-js": "~1.14.6",
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "js-yaml@^4": "^4.3.2",
    "adm-zip": "^0.6.1",
    "basic-ftp": "^6.2.3",
    "compression": "^1.8.2",
    "handlebars": "^4.7.10",
    "nodemailer": "^10.1.2",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "nx": {
      "undici": "^7.30.1"
    },
    "tar": "^7.5.22"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": "eslint --fix --no-warn-ignored"
  }
}
