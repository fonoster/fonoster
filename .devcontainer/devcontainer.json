// The Fonoster dev container: the only way to develop Fonoster (CONTRIBUTING.md).
//
// compose.yaml runs the `workspace` (Node 22, Go, protoc: you run our components here from
// source with `npm run dev`) and the dependencies from the self-host bundle (Postgres, NATS,
// Routr, RTPEngine, MinIO, Envoy), which start with the container.
{
  "name": "Fonoster",
  "dockerComposeFile": ["compose.yaml"],
  "service": "workspace",
  "runServices": [
    "workspace",
    "nats",
    "postgres",
    "routr",
    "rtpengine",
    "minio",
    "envoy",
    "nats-test"
  ],
  "workspaceFolder": "/workspaces/fonoster",
  // On the host, before the containers exist: the dev config in .dev/ (secrets, keys, service
  // files), which Compose needs to start the dependencies. Only the first time.
  "initializeCommand": "sh .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Closing the editor leaves the containers running, so agents and test runs that use them
  // (Postgres, NATS) are not cut off. Stop them with `docker compose -p fonoster-dev stop`.
  "shutdownAction": "none",
  "remoteUser": "node",
  // gh, to open pull requests from the container. Log in once with `gh auth login`.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Envoy publishes the dashboard and the API on the host (HTTP_PORT in .dev/.env, 8449 by
  // default) and Routr publishes SIP (SIP_PORT, 5060): nothing to forward for them.
  "forwardPorts": [6006],
  "portsAttributes": {
    "6006": { "label": "Storybook" }
  },
  // Every other port the components open (Autopilot's WebSocket, the fakes, Vite) is internal:
  // the editor must not forward it or offer it in a browser.
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "golang.go",
        "ms-playwright.playwright"
      ]
    }
  }
}
