# No trailing slash: a worktree links node_modules as a symlink, which git sees as a file
node_modules
.env*
!.env.example
*.log
reporting/*
out/*
dist
coverage
.nyc_output
.keys
# Signing keys and the certificate init generates for getting started (local CA and server
# certificate) are per install (fonoster-config init, ops/rebuild/stack), never committed: at the
# root and in the bundle folder, where init may run against ops/bundle itself.
/config/keys/
/config/tls/
/ops/bundle/config/keys/
/ops/bundle/config/tls/
*.tsbuildinfo
tsconfig.tsbuildinfo
integrations.json
config/agent*
!agent.example.json
# Service config files hold secrets; only the *.example.* versions are committed
config/fonoster.yaml
config/fonoster.yml
config/fonoster.json
config/fonoster.jsonc
config/autopilot.yaml
config/autopilot.yml
config/autopilot.json
config/autopilot.jsonc
config/identity.yaml
config/identity.yml
config/identity.jsonc
.next
next-env.d.ts
.npmrc
# ai-coustics models downloaded by the filter bench
/models/
mods/common/test/.prisma-client
mods/common/test/.prisma-work

# Generated on install and build, never committed: the Prisma clients (postinstall) and the Identity
# proto copy (mods/identity-client/scripts/sync-proto.mjs)
mods/identity/src/generated/
mods/billing/src/generated/
mods/identity-client/proto/

# The rebuild stack generates configs, keys and secrets here (ops/rebuild/stack)
ops/rebuild/.local/

# The dev container's generated config and secrets (.devcontainer/initialize.sh)
/.dev/

# A private cell's local keys (docs/operators/regions.md)

# The devcontainer CLI writes this lock on each machine
.devcontainer/devcontainer-lock.json

# Local git worktrees
/.worktrees/

# QA results (mods/conformance/catalog/report.cjs reads them; they are never committed)
reports/

# roomr-fake binaries (mods/conformance/scripts/fetch-roomr-fake.cjs)
.roomr-fake/
