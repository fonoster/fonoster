{
  "name": "@fonoster/stripe-fake",
  "version": "0.34.0",
  "private": true,
  "description": "A stateful fake of the part of Stripe Billing that Fonoster's billing uses, with a viewer",
  "author": "Pedro Sanders <psanders@fonoster.com>",
  "homepage": "https://github.com/fonoster/fonoster#readme",
  "license": "MIT",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json && vite build --config viewer/vite.config.ts --logLevel warn",
    "dev:viewer": "vite --config viewer/vite.config.ts",
    "test:viewer": "playwright test --config viewer/playwright.config.ts",
    "extract:openapi": "tsx scripts/extract-openapi.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ws": "^8.18.0"
  },
  "bin": {
    "fonoster-stripe-fake": "dist/main.js"
  },
  "files": [
    "dist",
    "spec",
    "viewer/dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonoster/fonoster.git"
  },
  "bugs": {
    "url": "https://github.com/fonoster/fonoster/issues"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.540.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4"
  }
}
