{
  "name": "@fonoster/appbridge",
  "version": "0.34.2",
  "private": true,
  "description": "AppBridge: serves each call to its app over the Fonoster session protocol",
  "author": "Pedro Sanders <psanders@fonoster.com>",
  "homepage": "https://github.com/fonoster/fonoster#readme",
  "license": "MIT",
  "main": "dist/index",
  "types": "dist/index",
  "bin": {
    "fonoster-appbridge": "dist/main.js"
  },
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/main.js",
    "replay": "tsx scripts/replay.ts",
    "scale": "tsx scripts/scale.ts",
    "live-check": "tsx scripts/live-check.ts"
  },
  "dependencies": {
    "@fonoster/amd": "^0.34.2",
    "@fonoster/callrecord": "^0.34.1",
    "@fonoster/common": "^0.34.2",
