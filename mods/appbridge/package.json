    "@fonoster/identity-client": "^0.34.1",
    "@fonoster/logger": "^0.34.1",
    "@grpc/grpc-js": "~1.14.6",
    "@prisma/client": "^6.19.1",
    "ajv": "^8.17.1",
    "grpc-health-check": "^2.0.2",
    "nats": "^2.25.0",
    "prisma-field-encryption": "^1.6.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@ai-coustics/aic-sdk": "^0.24.0"
  },
  "devDependencies": {
    "@fonoster/conformance": "^0.34.2",
    "@routr/common": "^2.24.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
