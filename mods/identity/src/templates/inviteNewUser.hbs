<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>You're invited to {{workspaceName}} on Fonoster</title>
  <style>
    @media (prefers-color-scheme: dark) {
      .page { background-color: #181818 !important; }
      .card { background-color: #202020 !important; border-color: #333333 !important; }
      .text { color: #FFFFFF !important; }
      .muted { color: #C2C2C2 !important; }
      .code { background-color: #252525 !important; border-color: #333333 !important; }
      .rule { border-color: #333333 !important; }
    }
  </style>
</head>
<body class="page" style="margin:0;padding:0;background-color:#F4F4F4;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">Accept the invitation, then sign in with the temporary password inside.</div>
  <table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F4F4;">
    <tr>
      <td align="center" style="padding:24px;">
        <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#FFFFFF;border:1px solid #E8E8E8;border-radius:10px;">
          <tr>
            <td style="padding:24px 32px;background-color:#FFFFFF;border-bottom:1px solid #E8E8E8;border-radius:10px 10px 0 0;">
              <img src="{{logoUrl}}" width="124" height="32" alt="Fonoster" style="display:block;border:0;">
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h1 class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.3;font-weight:600;color:#252525;">Join {{workspaceName}} on Fonoster</h1>
              <p class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;color:#252525;">You've been invited to the {{workspaceName}} workspace on Fonoster.</p>
              <p class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;color:#252525;">Your temporary password:</p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
                <tr>
                  <td class="code" style="padding:10px 16px;background-color:#F4F4F4;border:1px solid #E8E8E8;border-radius:10px;">
                    <span class="text" data-otp style="font-family:'Roboto Mono', Menlo, Consolas, monospace;font-size:18px;font-weight:500;letter-spacing:1px;color:#252525;">{{oneTimePassword}}</span>
                  </td>
                </tr>
              </table>
              <p class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;color:#252525;">Accept the invitation, then sign in with this email address and the temporary password. You'll be asked to choose a new password.</p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
                <tr>
                  <td bgcolor="#39E19E" style="background-color:#39E19E;border-radius:10px;">
                    <a href="{{inviteUrl}}" style="display:inline-block;padding:12px 24px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;font-weight:bold;color:#011900;text-decoration:none;border-radius:10px;">Accept invitation</a>
                  </td>
                </tr>
              </table>
              <p class="muted" style="margin:0;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:14px;line-height:1.6;color:#555555;">If the link has expired, ask the person who invited you to send it again.</p>
            </td>
          </tr>
          <tr>
            <td class="rule" style="padding:20px 32px;border-top:1px solid #E8E8E8;">
              <p class="muted" style="margin:0;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:13px;line-height:1.6;color:#555555;">You got this email because someone invited you to a workspace on Fonoster. If you weren't expecting it, you can ignore it.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
