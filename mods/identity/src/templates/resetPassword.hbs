<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>Reset your Fonoster password</title>
  <style>
    @media (prefers-color-scheme: dark) {
      .page { background-color: #181818 !important; }
      .card { background-color: #202020 !important; border-color: #333333 !important; }
      .text { color: #FFFFFF !important; }
      .muted { color: #C2C2C2 !important; }
      .code { background-color: #252525 !important; border-color: #333333 !important; }
      .rule { border-color: #333333 !important; }
    }
  </style>
</head>
<body class="page" style="margin:0;padding:0;background-color:#F4F4F4;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">Use this link within 5 minutes to choose a new password.</div>
  <table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F4F4;">
    <tr>
      <td align="center" style="padding:24px;">
        <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#FFFFFF;border:1px solid #E8E8E8;border-radius:10px;">
          <tr>
            <td style="padding:24px 32px;background-color:#FFFFFF;border-bottom:1px solid #E8E8E8;border-radius:10px 10px 0 0;">
              <img src="{{logoUrl}}" width="124" height="32" alt="Fonoster" style="display:block;border:0;">
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h1 class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.3;font-weight:600;color:#252525;">Reset your password</h1>
              <p class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;color:#252525;">We got a request to reset the password for your Fonoster account.</p>
              <p class="text" style="margin:0 0 16px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;color:#252525;">Select the button to choose a new password. The link expires in 5 minutes.</p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;">
                <tr>
                  <td bgcolor="#39E19E" style="background-color:#39E19E;border-radius:10px;">
                    <a href="{{resetPasswordUrl}}" style="display:inline-block;padding:12px 24px;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:15px;line-height:1.6;font-weight:bold;color:#011900;text-decoration:none;border-radius:10px;">Reset password</a>
                  </td>
                </tr>
              </table>
              <p class="muted" style="margin:0;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:14px;line-height:1.6;color:#555555;">If the link has expired, request a new one from the sign-in page.</p>
            </td>
          </tr>
          <tr>
            <td class="rule" style="padding:20px 32px;border-top:1px solid #E8E8E8;">
              <p class="muted" style="margin:0;font-family:Poppins, Helvetica, Arial, sans-serif;font-size:13px;line-height:1.6;color:#555555;">If you didn't ask to reset your password, ignore this email. Your password won't change.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
