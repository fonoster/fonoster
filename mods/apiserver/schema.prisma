generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("APISERVER_DATABASE_URL")
}

model Application {
  ref         String          @id @default(uuid())
  accessKeyId String          @map("access_key_id")
  name        String          @db.VarChar(255)
  type        ApplicationType
  endpoint    String          @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @map("updated_at")

  // rebuild: persistence. The session app model (voice-session G2); legacy columns above stay.
  // The workspace is accessKeyId (the AppConfig's workspaceRef).
  url              String? @db.VarChar(1024)
  protocol         String? @db.VarChar(16)
  signingSecret    String? @map("signing_secret_hash") /// @encrypted
  speechVoice      String? @map("speech_voice") @db.VarChar(255)
  speechLanguage   String? @map("speech_language") @db.VarChar(64)
  speechSttModel   String? @map("speech_stt_model") @db.VarChar(255)
  speechTtsModel   String? @map("speech_tts_model") @db.VarChar(255)
  speechSettings   Json?   @map("speech_settings")
  silenceTimeoutMs Int?    @map("silence_timeout_ms")
  audio            Json?
  filters          Json?
  listeners        Json?
  fallbackAppRef   String? @map("fallback_app_ref")
  fallbackMessage  String? @map("fallback_message")
  // rebuild: control. Recording policy (off | on | consent; null inherits the workspace's) and
  // the Pacing policy's patience (low | normal | high; null is normal).
  recording        String? @db.VarChar(16)
  patience         String? @db.VarChar(16)
  // rebuild: amdopus (AO-B1). Answering-machine detection: on/off and the window of caller
  // audio to classify in ms (null: 4000).
  amd              Boolean @default(false)
  amdWindowMs      Int?    @map("amd_window_ms")

  // Relations
  textToSpeech TextToSpeech?
  speechToText SpeechToText?
  intelligence Intelligence?

  // Indexes and maps
  @@index([accessKeyId], type: Hash)
  @@index([speechVoice])
  @@index([speechSttModel])
  @@index([speechTtsModel])
  @@map("applications")
}

model TextToSpeech {
  ref         String  @id @default(uuid())
  config      Json
  credentials String? @map("credentials_hash") /// @encrypted

  // Relations
  application    Application @relation(fields: [applicationRef], references: [ref], onDelete: Cascade)
  applicationRef String      @unique @map("application_ref")
  product        Product     @relation(fields: [productRef], references: [ref], onDelete: Cascade)
  productRef     String      @map("product_ref")

  // Indexes and maps
  @@index([applicationRef], type: Hash)
  @@index([productRef], type: Hash)
  @@map("tts_services")
}

model SpeechToText {
  ref         String  @id @default(uuid())
  config      Json
  credentials String? @map("credentials_hash") /// @encrypted

  // Relations
  application    Application @relation(fields: [applicationRef], references: [ref], onDelete: Cascade)
  applicationRef String      @unique @map("application_ref")
  product        Product     @relation(fields: [productRef], references: [ref], onDelete: Cascade)
  productRef     String      @map("product_ref")

  // Indexes and maps
  @@index([applicationRef], type: Hash)
  @@index([productRef], type: Hash)
  @@map("stt_services")
}

model Intelligence {
  ref         String  @id @default(uuid())
  config      Json
  credentials String? @map("credentials_hash") /// @encrypted

  // Relations
  application    Application @relation(fields: [applicationRef], references: [ref], onDelete: Cascade)
  applicationRef String      @unique @map("application_ref")
  Product        Product     @relation(fields: [productRef], references: [ref], onDelete: Cascade)
  productRef     String      @map("product_ref")

  // Indexes and maps
  @@index([applicationRef], type: Hash)
  @@index([productRef], type: Hash)
  @@map("intelligence_services")
}

model Product {
  ref    String        @id
  name   String
  vendor ProductVendor
  type   ProductType

  // Relations
  speechToText SpeechToText[]
  sextToSpeech TextToSpeech[]
  intelligence Intelligence[]

  // Indexes and maps
  @@map("products")
}

model Secret {
  ref         String   @id @default(uuid())
  accessKeyId String   @map("access_key_id")
  name        String
  secret      String   @map("secret_hash") /// @encrypted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  // Relations (rebuild: persistence)
  providerKeys WorkspaceProviderKey[]

  // Indexes and maps
  @@index([accessKeyId], type: Hash)
  @@index([name], type: Hash)
  @@map("secrets")
}

enum ApplicationType {
  STREAM
  AUTOPILOT

  // Maps
  @@map("application_types")
}

enum ProductType {
  TTS
  STT
  LLM

  // Maps
  @@map("product_types")
}

enum ProductVendor {
  GOOGLE
  MICROSOFT
  AMAZON
  DEEPGRAM
  IBM
  RASA
  OPENAI
  GROQ
  ANTHROPIC
  ELEVEN_LABS
  GENERIC

  // Maps
  @@map("product_vendors")
}

// rebuild: persistence ------------------------------------------------------------------------
// Provider registry (add-provider-registry), workspace webhooks (add-workspace-webhooks). No
// column here can hold a vendor key (P8): providers name a credentialRef, workspace keys point at
// an encrypted, write-only Secret.

enum RegistryState {
  ACTIVE
  DEPRECATED
  RETIRED

  @@map("registry_states")
}

model RegistryProvider {
  id            String        @id @db.VarChar(64)
  adapter       String        @db.VarChar(64)
  capabilities  String[]
  /// Null for a keyless provider (no key needed).
  credentialRef String?       @map("credential_ref") @db.VarChar(128)
  label         String?       @db.VarChar(255)
  /// Where the provider serves each capability ({tts, stt, llm} URLs); {} when it names none.
  endpoints     Json          @default("{}")
  state         RegistryState @default(ACTIVE)
  replacement   String?       @db.VarChar(255)
  retireOn      String?       @map("retire_on") @db.VarChar(10)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("registry_providers")
}

model RegistryModel {
  id          String        @id @db.VarChar(255)
  providerId  String        @map("provider_id") @db.VarChar(64)
  label       String?       @db.VarChar(255)
  type        String        @db.VarChar(8)
  features    String[]
  languages   String[]
  settings    String[]
  state       RegistryState @default(ACTIVE)
  replacement String?       @db.VarChar(255)
  retireOn    String?       @map("retire_on") @db.VarChar(10)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([providerId])
  @@map("registry_models")
}

model RegistryVoice {
  id             String        @id @db.VarChar(255)
  providerId     String        @map("provider_id") @db.VarChar(64)
  label       String?       @db.VarChar(255)
  language       String?       @db.VarChar(64)
  gender         String?       @db.VarChar(32)
  ownerWorkspace String?       @map("owner_workspace")
  state          RegistryState @default(ACTIVE)
  replacement    String?       @db.VarChar(255)
  retireOn       String?       @map("retire_on") @db.VarChar(10)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  models RegistryVoiceModel[]

  @@index([providerId])
  @@map("registry_voices")
}

/// Which models a voice works on. No foreign key to the model: `apply` may write a voice before its
/// models, and the registry checks the reference itself.
model RegistryVoiceModel {
  voiceId  String        @map("voice_id") @db.VarChar(255)
  modelId  String        @map("model_id") @db.VarChar(255)
  /// Keeps the order the operator gave.
  position Int           @default(0)
  voice    RegistryVoice @relation(fields: [voiceId], references: [id], onDelete: Cascade)

  @@id([voiceId, modelId])
  @@map("registry_voice_models")
}

/// Append-only: one row per registry write and per rewritten config (P8.6).
model RegistryAudit {
  seq     BigInt   @id @default(autoincrement())
  at      DateTime
  actor   String   @db.VarChar(255)
  action  String   @db.VarChar(64)
  target  String   @db.VarChar(255)
  details Json?

  @@index([target])
  @@map("registry_audit")
}

/// Dashboard notices about catalog changes (deprecations and retirements), per workspace.
model RegistryNotice {
  ref         String   @id @default(uuid())
  accessKeyId String   @map("access_key_id")
  type        String   @db.VarChar(64)
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accessKeyId])
  @@map("registry_notices")
}

/// Sessions per workspace, catalog id and day that resolved the id at runtime (registry `usage`,
/// LO-B11). Filled from the AppBridge replicas' `registry.used` events.
model RegistryUsage {
  accessKeyId String   @map("access_key_id")
  catalogId   String   @map("catalog_id") @db.VarChar(255)
  day         DateTime @db.Date
  sessions    Int      @default(0)

  @@id([accessKeyId, catalogId, day])
  @@index([catalogId, day])
  @@map("registry_usage")
}

/// A workspace's own vendor key (P1): a binding from a catalog provider to a Secret. The key itself
/// is only in the encrypted, write-only Secret.
model WorkspaceProviderKey {
  ref         String   @id @default(uuid())
  accessKeyId String   @map("access_key_id")
  providerId  String   @map("provider_id") @db.VarChar(64)
  secretRef   String   @map("secret_ref")
  secret      Secret   @relation(fields: [secretRef], references: [ref], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([accessKeyId, providerId])
  @@map("workspace_provider_keys")
}

model WebhookEndpoint {
  ref            String    @id @db.VarChar(64)
  accessKeyId    String    @map("access_key_id")
  url            String    @db.VarChar(2048)
  events         String[]
  secret         String    @map("secret_hash") /// @encrypted
  /// The previous secret keeps verifying until previousUntil (rotation window, W4).
  previousSecret String?   @map("previous_secret_hash") /// @encrypted
  previousUntil  DateTime? @map("previous_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([accessKeyId])
  @@map("webhook_endpoints")
}

/// The delivery log (W6). No foreign key: deliveries outlive a deleted endpoint and fail.
model WebhookDelivery {
  ref            String    @id @db.VarChar(64)
  endpointRef    String    @map("endpoint_ref") @db.VarChar(64)
  accessKeyId    String    @map("access_key_id")
  eventId        String    @map("event_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(64)
  event          Json
  status         String    @db.VarChar(16)
  attempts       Int       @default(0)
  firstAttemptAt DateTime? @map("first_attempt_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  lastStatus     Int?      @map("last_status")
  nextAttemptAt  DateTime  @map("next_attempt_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([endpointRef, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// end rebuild: persistence --------------------------------------------------------------------
// rebuild: records
// Call records (add-call-record). The control plane keeps only an index entry per record (design
// V2); the vCons and recordings stay in the region's (or the workspace's) object storage.

model CallRecord {
  callRef         String    @id @map("call_ref")
  accessKeyId     String?   @map("access_key_id")
  appRef          String?   @map("app_ref")
  fromNumber      String?   @map("from_number")
  toNumber        String?   @map("to_number")
  direction       String?
  status          String
  endReason       String?   @map("end_reason")
  failureReason   String?   @map("failure_reason")
  sipStatus       Int?      @map("sip_status")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int       @default(0) @map("duration_seconds")
  region          String
  location        String
  version         Int
  size            BigInt    @default(0)
  parts           String[]
  erasedAt        DateTime? @map("erased_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  // Indexes and maps
  @@index([accessKeyId, startedAt])
  @@map("call_records")
}

model CallRecordAudit {
  ref         String   @id @default(uuid())
  callRef     String   @map("call_ref")
  accessKeyId String?  @map("access_key_id")
  action      String
  part        String
  reason      String
  actor       String
  version     Int
  at          DateTime

  // Indexes and maps
  @@index([callRef])
  @@index([accessKeyId, at])
  @@map("call_record_audits")
}

model CallRecordRetention {
  ref         String   @id @default(uuid())
  accessKeyId String   @map("access_key_id")
  part        String
  days        Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Indexes and maps
  @@unique([accessKeyId, part])
  @@map("call_record_retention")
}

// rebuild: regions
// Private regions (add-private-regions). A region belongs to exactly one workspace (PR-2); the
// workspace's `region` column (Identity) holds the region ref. Secrets values are never stored here.

model Region {
  ref                 String    @id @db.VarChar(64)
  /// The region id (PR-18): unique per owner (private) or among public regions; never changes.
  id                  String    @db.VarChar(32)
  /// public | private (PR-13)
  kind                String    @default("private") @db.VarChar(16)
  /// The owning user of a private region (PR-14); null for public regions.
  ownerRef            String?   @map("owner_ref") @db.VarChar(255)
  displayName         String    @default("") @map("display_name") @db.VarChar(120)
  /// The customer's SIP domain (PR-16); Routr gives workspaces subdomains of it.
  sipDomain           String?   @map("sip_domain") @db.VarChar(253)
  /// Public regions: offered in pickers (while connected) once published (PR-19).
  published           Boolean   @default(false)
  /// Legacy (old model): the one workspace a private region was created for; used to backfill ownerRef.
  accessKeyId         String?   @map("access_key_id")
  /// waiting (never enrolled or disconnected) | enrolled. The shown status adds heartbeat rules.
  state               String    @default("waiting") @db.VarChar(16)
  cellPublicKey       String?   @map("cell_public_key")
  version             String?   @db.VarChar(64)
  components          Json?
  activeCalls         Int       @default(0) @map("active_calls")
  secretsSet          String[]  @map("secrets_set")
  reportedConfig      Int       @default(0) @map("reported_config_version")
  configVersion       Int       @default(0) @map("config_version")
  /// Set when a bound workspace's config changed and no snapshot carries it yet (ST-3): a replica
  /// that dies inside the debounce window leaves it set, and another replica publishes.
  configChangedAt     DateTime? @map("config_changed_at")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  enrolledAt          DateTime? @map("enrolled_at")
  /// Connection details the cell reported (region.R.endpoints), cleaned.
  endpoints           Json?
  endpointsHash       String?   @map("endpoints_hash") @db.VarChar(64)
  endpointsAt         DateTime? @map("endpoints_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  // Uniqueness of ids is enforced by partial indexes in the migration (live rows only).
  @@index([ownerRef])
  @@map("regions")
}

/// A download relayed from a private region (ST-4): the relay limit is per region across every
/// apiserver replica. A slot is a lease, refreshed while the download runs.
model RegionRelaySlot {
  regionRef String   @map("region_ref") @db.VarChar(64)
  slot      Int
  holder    String   @db.VarChar(64)
  expiresAt DateTime @map("expires_at")

  @@id([regionRef, slot])
  @@map("region_relay_slots")
}

/// One enrollment token (single use, 24 h). Only its id is kept, never the token.
model RegionToken {
  jti        String    @id @db.VarChar(64)
  regionRef  String    @map("region_ref") @db.VarChar(64)
  issuedAt   DateTime  @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")

  @@index([regionRef])
  @@map("region_tokens")
}

/// The NATS users issued to a region's cell; a revoked one is in the REGIONS account revocations.
model RegionCredential {
  userPublicKey String    @id @map("user_public_key") @db.VarChar(64)
  regionRef     String    @map("region_ref") @db.VarChar(64)
  issuedAt      DateTime  @map("issued_at")
  revokedAt     DateTime? @map("revoked_at")

  @@index([regionRef])
  @@map("region_credentials")
}

/// Minutes reported by the cell per period (visibility only; flat fee billing, PR-11).
model RegionUsage {
  regionRef String   @map("region_ref") @db.VarChar(64)
  /// The workspace the minutes belong to ('' for legacy rows).
  accessKeyId String @default("") @map("access_key_id") @db.VarChar(255)
  period    String   @db.VarChar(16)
  minutes   Float
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([regionRef, accessKeyId, period])
  @@map("region_usage")
}

/// One usage line (add-usage-metering): a fact, never a price. Append-only; the id is derived from
/// what it measures, so the same usage reported twice is stored once.
model UsageEvent {
  id           String   @id @db.VarChar(40)
  ownerRef     String   @map("owner_ref") @db.VarChar(255)
  workspaceRef String   @map("workspace_ref") @db.VarChar(255)
  appRef       String?  @map("app_ref") @db.VarChar(255)
  callRef      String?  @map("call_ref") @db.VarChar(255)
  region       String   @db.VarChar(64)
  regionKind   String   @map("region_kind") @db.VarChar(16)
  origin       String   @db.VarChar(16)
  meter        String   @db.VarChar(64)
  unit         String   @db.VarChar(16)
  quantity     BigInt
  provider     String?  @db.VarChar(64)
  model        String?  @db.VarChar(255)
  keySource    String?  @map("key_source") @db.VarChar(16)
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Set once the billing outbox published the event (add-billing-service D2); null until then.
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([workspaceRef, occurredAt])
  @@index([callRef])
  @@map("usage_events")
}

/// Daily usage totals, derived only from usage_events and rebuildable from them (fonoster-usage
/// rebuild). Absent dimensions are '' so the key is unique.
model UsageDaily {
  ownerRef     String   @map("owner_ref") @db.VarChar(255)
  workspaceRef String   @map("workspace_ref") @db.VarChar(255)
  day          DateTime @db.Date
  meter        String   @db.VarChar(64)
  provider     String   @default("") @db.VarChar(64)
  model        String   @default("") @db.VarChar(255)
  keySource    String   @default("") @map("key_source") @db.VarChar(16)
  origin       String   @db.VarChar(16)
  regionKind   String   @map("region_kind") @db.VarChar(16)
  quantity     BigInt
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([ownerRef, workspaceRef, day, meter, provider, model, keySource, origin, regionKind])
  @@index([workspaceRef, day])
  @@map("usage_daily")
}
