    "fonoster-usage": "./dist/bin/usage.js",
    "fonoster-owner": "./dist/bin/owner.js"
  },
  "dependencies": {
    "@fonoster/authz": "^0.46.0",
    "@fonoster/autopilot": "^0.46.0",
    "@fonoster/callrecord": "^0.46.0",
    "@fonoster/common": "^0.46.0",
    "@fonoster/identity": "^0.46.0",
    "@fonoster/logger": "^0.46.0",
    "@fonoster/sipnet": "^0.46.0",
    "@fonoster/types": "^0.46.0",
    "@grpc/grpc-js": "~1.14.6",
    "@prisma/client": "^6.19.1",
    "@routr/common": "^2.24.0",
    "@routr/sdk": "^2.24.0",
    "express": "^5.0.1",
    "grpc-health-check": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "nanoid": "^3.3.11",
    "nats": "^2.25.0",
    "nkeys.js": "^1.1.0",
    "pb-util": "^1.0.3",
    "prisma-field-encryption": "^1.6.0",
    "uuid": "^11.0.3",
