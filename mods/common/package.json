{
  "name": "@fonoster/common",
  "version": "0.43.0",
  "description": "Common library for Fonoster projects",
  "author": "Pedro Sanders <psanders@fonoster.com>",
  "homepage": "https://github.com/fonoster/fonoster#readme",
  "license": "MIT",
  "main": "dist/index",
  "types": "dist/index",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "prebuild": "rimraf ./dist tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json",
    "postbuild": "cp -a src/protos dist",
    "generate:session-schema": "tsx scripts/export-session-schema.ts",
    "generate:config-schemas": "tsx scripts/export-config-schemas.ts"
  },
  "dependencies": {
    "@fonoster/logger": "^0.43.0",
    "@fonoster/types": "^0.43.0",
    "@grpc/grpc-js": "~1.14.6",
    "@grpc/proto-loader": "^0.7.15",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "ajv": "^8.17.1",
    "grpc-health-check": "^2.0.2",
    "handlebars": "^4.7.8",
    "json-schema-to-ts": "^3.1.1",
    "jsonc-parser": "^3.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "nkeys.js": "^1.1.0",
    "nodemailer": "^10.1.2",
    "pb-util": "^1.0.3",
    "twilio": "^5.11.1",
    "validator": "^13.12.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonoster/fonoster.git"
  },
  "bugs": {
    "url": "https://github.com/fonoster/fonoster/issues"
  },
  "devDependencies": {
    "@fonoster/roomr": "0.4.0"
  },
  "gitHead": "d4aa82f7926c0f451d2f580c59ab812c74a7f579",
  "bin": {
    "fonoster-registry": "dist/registry/cli.js"
  }
}
